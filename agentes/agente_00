# Importa o módulo 'os' (Operating System), que permite interagir com o sistema operacional, como ler variáveis de ambiente.
import os

# Importa o módulo 'sys' (System-specific parameters and functions), usado aqui para encerrar o programa (sys.exit) caso ocorra um erro.
import sys

# Importa funções da biblioteca 'dotenv'.
# - find_dotenv: ajuda a localizar o arquivo oculto chamado '.env'.
# - load_dotenv: carrega as variáveis escritas dentro desse arquivo '.env' para o nosso programa.
from dotenv import find_dotenv, load_dotenv

# Importa a classe 'OpenAI' da biblioteca 'openai'.
# Essa biblioteca é usada para se conectar à API da OpenAI (ou outras APIs compatíveis, como a OpenRouter, que estamos usando aqui).
from openai import OpenAI

# 1. Carrega as variáveis do arquivo .env para a memória do programa.
# Isso é importante para não deixar senhas ou chaves de API expostas diretamente no código.
load_dotenv(find_dotenv())

# 2. Captura e valida as variáveis de ambiente.
# Tenta pegar a variável "OPENROUTER_API_KEY" que acabamos de carregar do .env.
api_key = os.environ.get("OPENROUTER_API_KEY")

# Tenta pegar o modelo de IA que vamos usar. Se não estiver no .env, usa "google/gemma-4-26b-a4b-it:free" como padrão.
modelo = os.environ.get("OPENROUTER_MODEL", "google/gemma-4-26b-a4b-it:free")

# Verifica se a chave da API foi encontrada.
if not api_key:
    # Se não houver chave (estiver vazia), imprime uma mensagem de erro na tela para avisar o usuário.
    print("\n[ERRO] A variável OPENROUTER_API_KEY não foi encontrada.")
    print("Verifique se o arquivo .env existe e contém: OPENROUTER_API_KEY=sua_chave_aqui\n")
    # Encerra o programa imediatamente com código de erro 1 (indicando que parou devido a um problema).
    sys.exit(1)

# 3. Instancia (cria) o cliente da OpenAI, mas configurado para usar o OpenRouter (um serviço que agrupa várias IAs).
client = OpenAI(
    # Muda o endereço base da API para apontar para o OpenRouter em vez da OpenAI padrão.
    base_url="https://openrouter.ai/api/v1",
    # Passa a chave de acesso que validamos ali em cima.
    api_key=api_key,
    # Adiciona alguns "cabeçalhos" (informações extras) necessários ou recomendados pelo OpenRouter.
    default_headers={
        "HTTP-Referer": "http://localhost", # De onde a requisição está vindo (exigência de alguns serviços)
        "X-Title": "Aula de Prompt Engineering", # Nome do nosso projeto ou app
    }
)

# Define uma função (um bloco de código que podemos chamar) para rodar o nosso chat no terminal.
def executar_terminal():
    # Imprime um cabeçalho bonito no terminal.
    print("=" * 60)
    print("  LAB DE PROMPT ENGINEERING - TERMINAL")
    # Mostra qual modelo de IA estamos usando no momento.
    print(f"  Modelo ativo: {modelo}")
    print("  Digite 'sair' ou 'exit' a qualquer momento para fechar.")
    print("=" * 60 + "\n")

    # Permite ao usuário definir o "System Prompt" (instruções iniciais de como a IA deve se comportar).
    # O comando 'input' pausa o programa e espera o usuário digitar algo e apertar ENTER.
    # O '.strip()' remove espaços em branco extras no começo ou no fim do texto.
    system_custom = input("System Prompt [Pressione ENTER para o padrão]: ").strip()
    
    # Se o usuário digitou algo, usamos isso. Se apertou só ENTER (ficou vazio), usamos a frase padrão abaixo.
    system_prompt = system_custom if system_custom else "Você é um assistente focado em ajudar estudantes de Prompt Engineering com explicações diretas e claras."

    # Cria uma lista chamada 'messages' para guardar o histórico da conversa.
    # A primeira mensagem é sempre a do "system" (o comportamento base da IA).
    messages = [{"role": "system", "content": system_prompt}]

    # Inicia um loop infinito (vai repetir para sempre até mandarmos parar).
    while True:
        try: # O bloco 'try' tenta executar o código abaixo e nos permite lidar com erros sem "quebrar" o programa.
            
            # Pede para o usuário digitar a sua mensagem/pergunta.
            user_input = input("\nVocê > ").strip()

            # Verifica se o usuário digitou uma das palavras para sair. '.lower()' deixa tudo minúsculo para facilitar a verificação.
            if user_input.lower() in ["sair", "exit", "quit"]:
                print("\nEncerrando sessão. Bons estudos!")
                # O comando 'break' interrompe o loop infinito, fazendo o programa chegar ao fim.
                break

            # Se o usuário apertou ENTER sem digitar nada, o 'continue' pula para a próxima volta do loop (pede input de novo).
            if not user_input:
                continue

            # Adiciona a mensagem que o usuário digitou no histórico da conversa, identificando o autor como "user".
            messages.append({"role": "user", "content": user_input})

            # Imprime "Modelo > " e fica na mesma linha, preparando para mostrar a resposta.
            # O 'end=""' diz para não pular linha. O 'flush=True' garante que o texto apareça imediatamente na tela.
            print("\nModelo > ", end="", flush=True)

            # Envia o histórico de mensagens para a API para gerar a resposta.
            # Execução com "streaming" significa que vamos receber a resposta pedaço por pedaço, como se a IA estivesse digitando.
            stream = client.chat.completions.create(
                model=modelo,           # O modelo escolhido (ex: gemma)
                messages=messages,      # O histórico da nossa conversa
                temperature=0.7,        # Define a criatividade da resposta (0.0 é robótico, 1.0 é bem criativo/aleatório)
                max_tokens=600,         # Limita o tamanho máximo da resposta para não ficar gigante
                stream=True             # Ativa o recebimento em tempo real (pedacinhos)
            )

            # Variável para juntar todos os pedacinhos e formar a resposta completa.
            resposta_completa = ""
            
            # Para cada 'chunk' (pedacinho) que chega da API pelo stream...
            for chunk in stream:
                # Tenta pegar o conteúdo do texto. Se não vier texto, usa uma string vazia "".
                conteudo = chunk.choices[0].delta.content or ""
                # Imprime o pedacinho na tela, na mesma linha.
                print(conteudo, end="", flush=True)
                # Adiciona o pedacinho à variável que guarda a resposta completa.
                resposta_completa += conteudo

            print()  # Imprime apenas uma quebra de linha no final, quando a IA termina de falar.
            
            # Adiciona a resposta completa gerada pela IA ao histórico.
            # Identificando o autor como "assistant" (o assistente IA). Isso permite que a IA lembre do que falou antes.
            messages.append({"role": "assistant", "content": resposta_completa})

        # Esta exceção (erro) acontece quando o usuário aperta 'Ctrl + C' no teclado (atalho para forçar a parada).
        except KeyboardInterrupt:
            print("\n\nSessão interrompida pelo usuário.")
            break # Encerra o loop e o programa.
            
        # Pega qualquer outro erro não previsto (como problemas de internet, API fora do ar, etc).
        except Exception as e:
            # Imprime a mensagem de erro para nos ajudar a saber o que deu errado.
            print(f"\n[ERRO na API]: {e}")

# Esta é uma boa prática em Python. Verifica se o script está sendo rodado diretamente (e não importado por outro arquivo).
# Se for o caso, ele chama a função principal que criamos acima para dar início ao chat.
if __name__ == "__main__":
    executar_terminal()